+/* Controls */
+button,input,select,textarea{font:inherit;color:inherit}
+button{cursor:pointer;border:1px solid var(--line-strong);background:var(--panel);color:var(--ink);border-radius:var(--r-s);padding:9px 15px;font-weight:600;line-height:1.4;transition:background-color .12s,border-color .12s}
+button:hover{background:var(--inset);border-color:var(--muted)}
+button:disabled{opacity:.42;cursor:not-allowed}
+button:disabled:hover{background:var(--panel);border-color:var(--line-strong)}
+.primary,#accountsNext,#rulesNext,#newRule,#start{background:var(--go);border-color:var(--go);color:var(--go-on)}
+.primary:hover,#accountsNext:hover,#rulesNext:hover,#newRule:hover,#start:hover{background:var(--go-ink);border-color:var(--go-ink)}
+.primary:disabled:hover,#accountsNext:disabled:hover,#rulesNext:disabled:hover,#newRule:disabled:hover,#start:disabled:hover{background:var(--go);border-color:var(--go)}
+.danger{color:var(--stop)}
+.danger:not(:disabled):hover{background:var(--stop-wash);border-color:var(--stop)}
+.quiet{padding:6px 11px;font-size:13px;font-weight:600}
+:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
+label{display:block;font-size:13px;font-weight:600;margin:0 0 6px;color:var(--ink)}
+input,select,textarea{width:100%;min-width:0;border:1px solid var(--field-line);border-radius:var(--r-s);padding:9px 11px;background:var(--field)}
+textarea{resize:vertical;line-height:1.55}
+input:hover,select:hover,textarea:hover{border-color:var(--muted)}
+input[type=checkbox],input[type=radio]{width:auto;padding:0;accent-color:var(--go);margin:0 8px 0 0;vertical-align:-2px}
+input[type=file]{padding:7px;background:var(--inset)}
+input::placeholder,textarea::placeholder{color:var(--faint)}
+select[multiple]{padding:4px}
+fieldset{margin:0;min-width:0}
+legend{font-size:13px;font-weight:600;padding:0 6px}
+label:has(>input[type=checkbox]){display:flex;align-items:flex-start;gap:2px;font-weight:500;font-size:14px;margin:10px 0}
+label:has(>input[type=checkbox])>input{margin-top:4px;flex:none}
+.field{margin-bottom:16px}
+.field>label+input,.field>label+select,.field>label+textarea{margin-bottom:0}
+.field input+label,.field select+label,.field p+label{margin-top:14px}
+.hint{display:block;margin-top:6px;font-size:13px}
+.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
+.stack{display:grid;gap:8px;margin-top:10px}
+.spaced{margin-top:16px}
+
+/* Route board header */
+.board{background:var(--board);color:var(--board-ink)}
+.board-inner{max-width:1180px;margin:0 auto;padding:18px 28px 0}
+.board-top{display:flex;align-items:center;justify-content:space-between;gap:16px}
+.brand{display:flex;align-items:center;gap:11px;margin:0;font:600 22px/1 var(--sign);letter-spacing:.2px;color:#fff}
+.brand svg{flex:none}
+.badge{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;border-radius:999px;padding:5px 12px 5px 10px;white-space:nowrap;border:1px solid var(--line-strong);background:var(--panel)}
+.dot{width:9px;height:9px;border-radius:50%;background:var(--faint);flex:none}
+.badge.live .dot{background:var(--lamp);box-shadow:0 0 0 3px color-mix(in srgb,var(--lamp) 28%,transparent)}
+.board .badge{background:var(--board-2);border-color:#ffffff1f;color:var(--board-ink)}
+.board .badge .dot{background:#5d7680}
+.board .badge.live .dot{background:var(--lamp)}
+.workspace-nav{position:relative;display:flex;align-items:flex-start;gap:0;margin:18px 0 0;padding:0}
+.workspace-nav button{position:relative;display:flex;flex-direction:column;align-items:center;gap:7px;flex:0 1 150px;border:0;border-radius:var(--r-s) var(--r-s) 0 0;background:transparent;color:var(--board-muted);padding:4px 10px 14px;font-weight:600;font-size:14px}
+.workspace-nav button:hover{background:#ffffff0d;color:#fff}
+.workspace-nav .stop{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;border:2px solid #5d7680;background:var(--board);font:600 15px/1 var(--sign);color:var(--board-muted);position:relative;z-index:1}
+.workspace-nav .track-step::after{content:"";position:absolute;top:19px;left:calc(50% + 15px);width:calc(100% - 30px);height:2px;background:#5d7680}
+.workspace-nav button[aria-current=page]{color:#fff;background:var(--bg);color:var(--ink)}
+.workspace-nav button[aria-current=page] .stop{border-color:var(--go);background:var(--go);color:var(--go-on)}
+.workspace-nav #navSettings{margin-left:auto;flex:0 0 auto;flex-direction:row;align-self:flex-end;padding:9px 14px 12px}
+.workspace-nav #navSettings .gear{width:16px;height:16px;flex:none}
+.board-status{margin:0;font-size:13px;color:var(--board-muted);flex:1;text-align:right;min-width:0}
+#navOverview::after{display:none}
+
+/* Page */
+main{max-width:1180px;margin:0 auto;padding:22px 28px 28px}
+.route-info{font-size:13px;color:var(--muted);overflow-wrap:anywhere;margin:12px 0}
+#onboarding{margin:0 0 16px;font-size:14px;color:var(--ink)}
+.notice{margin:0 0 16px;padding:11px 14px 11px 16px;border:1px solid color-mix(in srgb,var(--stop) 35%,transparent);border-left:4px solid var(--stop);border-radius:var(--r-s);background:var(--stop-wash);color:var(--stop);font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere}
+.notice:empty{display:none}
+.layout:empty,.layout>aside:empty,.layout>div:empty{display:none}
+.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-l);padding:22px 24px;min-width:0}
+.heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
+.overview-help{color:var(--muted);margin:10px 0}
+.editor-message{color:var(--hold);background:var(--hold-wash);padding:9px 13px;border-radius:var(--r-s);font-size:14px}
+.editor-message:empty{display:none}
+details{border-top:1px solid var(--line);margin-top:18px;padding-top:12px;font-size:14px;color:var(--muted)}
+details p{margin:8px 0}
+summary{cursor:pointer;color:var(--ink);font-weight:600;list-style:none;display:flex;align-items:center;gap:8px;padding:2px 0}
+summary::-webkit-details-marker{display:none}
+summary::before{content:"";width:7px;height:7px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(-45deg);transition:transform .15s;flex:none;margin:0 3px}
+details[open]>summary::before{transform:rotate(45deg) translate(-2px,-1px)}
+details[open]>summary{margin-bottom:8px}
+details label,details input,details select,details textarea{color:var(--ink)}
+.workspace-panel{display:grid;gap:18px}
+.workspace-panel>.card{margin:0}
+
+/* Accounts */
+.account-grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
+.account-intro{grid-column:1/-1;display:grid;grid-template-columns:1fr auto;gap:4px 24px;align-items:center;background:var(--inset)}
+.account-intro h2,.account-intro p{grid-column:1}
+.account-intro #accountsNext{grid-column:2;grid-row:1/span 2}
+.account-intro #accountsNextHelp{grid-column:1/-1;font-size:13px}
+#qrImage{display:block;margin:16px auto 0;border-radius:var(--r-m);background:#fff;padding:8px;max-width:100%;height:auto}
+.auth-state{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;margin-top:14px;overflow-wrap:anywhere}
+.auth-state::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--faint);flex:none}
+#pin{font:600 34px/1.2 var(--sign);letter-spacing:8px;color:var(--go-ink);margin-top:6px;overflow-wrap:anywhere}
+#pin:empty{display:none}
+#groupCount{margin-top:10px;font-size:14px}
+#telegramStatus,#discordStatus{font-weight:600}
+
+/* Rules list */
+#ruleListCard>h2{font-size:20px}
