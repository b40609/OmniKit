 function render(){const id=$('group').value;const rows=[...collected.values()].filter(m=>m.groupId===id).sort((a,b)=>b.time-a.time);$('messages').replaceChildren();if(!rows.length){const empty=document.createElement('div');empty.className='empty';empty.textContent='尚無預覽訊息';$('messages').append(empty);}for(const m of rows){const article=document.createElement('article');article.className='message';const stamp=document.createElement('small');stamp.textContent=m.time?new Date(m.time).toLocaleString('zh-TW'):'時間未知';const text=document.createElement('pre');text.textContent=m.text||(m.decryptFailed?'[文字解密失敗]':'[非文字訊息]');article.append(stamp,text);$('messages').append(article);}controls();}
 async function read(){if(reading)return;const id=$('group').value;if(!id)throw new Error('請先選擇群組');reading=true;controls();try{const result=await api('messages',{id});for(const m of result.messages){const key=id+'|'+(m.id||JSON.stringify([m.time,m.sender,m.text,m.type]));collected.set(key,{...m,groupId:id,groupName:result.group});}while(collected.size>5000){collected.delete(collected.keys().next().value);$('notice').textContent='預覽已達 5,000 則，較舊內容已移除；請匯出需要保存的訊息。';}render();$('stats').textContent=new Date(result.checkedAt).toLocaleTimeString('zh-TW')+' 更新 · '+result.messages.length+' 則 · '+result.messages.filter(m=>m.text).length+' 則文字';}finally{reading=false;controls();}}
 async function loop(){try{if(!pending&&!lastState.busy)await read();}catch(e){$('notice').textContent=e.message;stopPreview();}if(polling)pollTimer=setTimeout(loop,10000);}
