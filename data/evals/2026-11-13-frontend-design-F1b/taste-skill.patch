+.card-meta { font-size: 13px; color: var(--muted); }
+.reason, .trial { font-size: 15px; line-height: 1.6; }
+.reason time { margin-right: 8px; font-size: 13px; color: var(--muted); }
+.install { margin-top: var(--s-2); display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
+.card details { font-size: 14px; color: var(--muted); }
+.card summary { width: fit-content; min-height: 32px; display: flex; align-items: center; gap: 6px; cursor: pointer; list-style: none; color: var(--ink); font-weight: 500; }
+.card summary::-webkit-details-marker { display: none; }
+.card summary::before { content: ""; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); transition: transform var(--m-out) var(--ease); }
+.card details[open] > summary::before { transform: rotate(45deg); }
+.card details p { margin-top: 6px; overflow-wrap: anywhere; }
+.card-foot { margin-top: auto; padding-top: var(--s-2); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 13px; color: var(--muted); border-top: 1px solid var(--line); }
 .card-foot a { color: var(--muted); }
 
