+def socket_state(slot, tools):
+    """槽位一覽上的一格：有預設就是滿的，其次是試用、內建的就夠，剩下的還在找。"""
+    def names(status):
+        return "、".join(t["name"] for t in ordered(tools) if t["status"] == status)
+    if names("default"):
+        return "filled", f"預設 {names('default')}"
+    if names("trial"):
+        return "trial", f"試用 {names('trial')}"
+    if any(a["verdict"] == "native" for a in (slot.get("answers") or {}).values()):
+        return "filled", "內建的就夠"
+    pending = sum(1 for t in tools if t["status"] == "pending")
+    if pending:
+        return "open", f"{pending} 張待評估"
+    return "empty", "還沒有工具卡"
+
+
+def rack(roster):
+    """槽位一覽：照層與模組排好每個槽位，點了跳到該槽位；搜尋時只有符合的會亮著。"""
+    tools = list(roster["tools"].values())
+    layers = []
+    for kind, label in LAYER.items():
+        modules = [m for m in roster["modules"] if m["kind"] == kind]
+        if not modules:
+            continue
+        groups = []
+        for m in modules:
+            sockets = []
+            for slot in (s for s in roster["slots"] if s["module"] == m["id"]):
+                state, text = socket_state(slot, [t for t in tools if slot["id"] in t["slots"]])
+                sockets.append(
+                    f'<li><a class="socket s-{state}" href="#slot-{slot["id"]}" data-slot="slot-{slot["id"]}">'
+                    f'<span class="socket-name">{esc(slot["name"])}</span><span class="socket-state">{esc(text)}</span></a></li>'
+                )
+            groups.append(f'<div class="rack-module"><h4><a href="#module-{m["id"]}">{esc(m["name"])}</a></h4>'
+                          f'<ul>{"".join(sockets)}</ul></div>')
+        layers.append(f'<div class="rack-layer"><h3>{label}<span>{esc(LAYER_NOTE[kind])}</span></h3>'
+                      f'<div class="rack-modules">{"".join(groups)}</div></div>')
+    loose = sum(1 for t in tools if not t["slots"])
+    if loose:
