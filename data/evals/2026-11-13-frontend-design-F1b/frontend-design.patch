+/* ---- 工具卡：已決定的大，待評估的精簡 ---- */
+.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); align-items: start; gap: 10px; min-width: 0; }
+.card { display: flex; flex-direction: column; gap: 5px; min-width: 0; padding: 12px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
+.card.st-default, .card.st-trial { grid-column: span 2; padding: 16px 18px; border: 2px solid var(--c); }
+@media (max-width: 1100px) { .card.st-default, .card.st-trial { grid-column: auto; } }
+.card.st-pending { background: transparent; border-style: solid; }
+.card.st-rejected, .card.st-retired { background: transparent; border-style: dashed; }
 .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
-.card h3 { margin: 0; font-size: 15px; line-height: 1.45; overflow-wrap: anywhere; }
+.card h3 { margin: 0; font-size: 15px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
+.card.st-default h3, .card.st-trial h3 { font-size: 19px; font-weight: 800; }
 .card h3 a { color: inherit; text-decoration: none; }
 .card h3 a:hover { text-decoration: underline; }
-.badge { flex: none; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; line-height: 1.6; color: var(--c); background: var(--cbg); }
-.card-meta { margin: 0; font-size: 12.5px; color: var(--muted); }
+.badge { flex: none; padding: 0 8px; border-radius: 999px; font-size: 12px; font-weight: 700; line-height: 1.7; color: var(--c); background: var(--cbg); }
+.card.st-pending .badge { background: transparent; padding: 0; font-weight: 500; }
+.card-meta { display: flex; flex-wrap: wrap; gap: 0 10px; margin: 0; font-size: 12.5px; color: var(--muted); }
 .reason, .trial { margin: 0; font-size: 13.5px; }
 .reason time { margin-right: 8px; font-size: 12px; color: var(--muted); }
 .install { margin-top: 6px; display: grid; gap: 4px; font-size: 12.5px; }
 .card details { font-size: 13px; color: var(--muted); }
 .card summary { width: fit-content; cursor: pointer; }
 .card details p { margin: 6px 0 0; overflow-wrap: anywhere; }
-.card-foot { margin-top: auto; padding-top: 4px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 12px; color: var(--muted); }
+.card-foot { margin-top: auto; padding-top: 2px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; font-size: 12px; color: var(--muted); }
 .card-foot a { color: var(--muted); }
 
-/* 評估紀錄與頁尾 */
-.evals .list li { grid-template-columns: minmax(0, 1fr); }
-footer { margin-top: 48px; padding: 24px 0 44px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
-footer p { margin: 0 0 6px; }
+/* ---- 頁尾 ---- */
+footer { margin-top: 72px; padding: 28px 0 48px; background: var(--board); color: var(--on-board-muted); font-size: 13.5px; }
+footer a { color: var(--on-board); }
+footer p { margin: 0 0 6px; max-width: 48em; }
+footer .meta { margin-bottom: 14px; font-size: 12.5px; }
+footer :focus-visible { outline-color: var(--board-ring); }
 
 @media (prefers-reduced-motion: no-preference) {
   html { scroll-behavior: smooth; }
