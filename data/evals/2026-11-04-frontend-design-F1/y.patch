diff --git a/src/styles/dashboard.css b/src/styles/dashboard.css
new file mode 100644
index 0000000..439e0ff
--- /dev/null
+++ b/src/styles/dashboard.css
@@ -0,0 +1,358 @@
+/* Dashboard polish: keep the compact, resizable Noir & Gold workbench. */
+.dashboard-shell {
+  --dashboard-rule: color-mix(in srgb, var(--foreground) 13%, var(--surface));
+  --dashboard-header: color-mix(in srgb, var(--surface-raised) 55%, var(--surface));
+  --dashboard-secondary: color-mix(in srgb, var(--foreground) 65%, var(--surface));
+  --dashboard-selected: color-mix(in srgb, var(--primary) 11%, var(--surface));
+}
+
+.dashboard-shell aside > a > span {
+  box-shadow: none;
+  border-radius: var(--radius);
+}
+
+.dashboard-shell nav a {
+  border: 1px solid transparent;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+
+.dashboard-shell nav a[aria-current="page"] {
+  background: var(--dashboard-selected);
+  border-color: color-mix(in srgb, var(--primary) 28%, transparent);
+  box-shadow: none;
+}
+
+.dashboard-shell nav a[aria-current="page"] span {
+  color: var(--primary);
+}
+
+.dashboard-shell nav a:not([aria-current]) > span {
+  color: var(--dashboard-secondary);
+}
+
+.dashboard-shell nav a > div > span:last-child {
+  font-size: var(--text-t1);
+  font-weight: 400;
+  letter-spacing: 0.04em;
+}
+
+.dashboard-shell nav > div > p {
+  color: var(--dashboard-secondary);
+  font-weight: 500;
+}
+
+.dashboard-shell [data-leaf-id] {
+  background: var(--surface);
+  border-color: var(--dashboard-rule);
+  box-shadow: none;
+  backdrop-filter: none;
+}
+
+.dashboard-shell .dashboard-card {
+  container: dashboard-panel / inline-size;
+  background: var(--surface);
+}
+
+.dashboard-shell .dashboard-panel-header {
+  min-height: 40px;
+  background: var(--dashboard-header);
+  border-bottom-color: var(--dashboard-rule);
+  padding-inline: 12px;
+}
+
+.dashboard-shell .dashboard-panel-title {
+  font-family: var(--font-sans);
+  font-size: 0.8125rem;
+  font-weight: 600;
+  letter-spacing: 0;
+}
+
+.dashboard-shell .dashboard-segmented {
+  gap: 2px;
+  background: var(--background);
+  border-color: var(--dashboard-rule);
+  border-radius: var(--radius);
+  max-width: 100%;
+}
+
+.dashboard-shell .dashboard-segmented button {
+  min-height: 24px;
+  padding: 3px 8px;
+  font-size: var(--text-t3);
+  font-family: var(--font-sans);
+  font-weight: 500;
+  color: var(--dashboard-secondary);
+  border: 1px solid transparent;
+  box-shadow: none;
+  white-space: nowrap;
+  transition: background-color 160ms ease, color 160ms ease;
+}
+
+.dashboard-shell .dashboard-segmented button[aria-pressed="true"] {
+  color: var(--primary);
+  background: var(--dashboard-selected);
+  border-color: color-mix(in srgb, var(--primary) 24%, transparent);
+}
+
+.dashboard-shell .dashboard-segmented button:hover {
+  color: var(--foreground);
+  background: var(--surface-raised);
+}
+
+.dashboard-shell :is(button, a, [tabindex]):focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: 2px;
+}
+
+.dashboard-shell .dashboard-equity-kpis {
+  background: color-mix(in srgb, var(--background) 30%, var(--surface));
+  padding: 10px;
+  border-color: var(--dashboard-rule);
+  scrollbar-width: thin;
+}
+
+.dashboard-shell .dashboard-equity-kpis .text-t2 {
+  font-size: var(--text-t3);
+}
+
+.dashboard-shell .dashboard-equity-kpis .text-t1 {
+  font-size: var(--text-t2);
+}
+
+.dashboard-shell .dashboard-equity-kpis .text-muted-foreground,
+.dashboard-shell .dashboard-equity-chart .text-muted-foreground {
+  color: var(--dashboard-secondary);
+}
+
+.dashboard-shell .dashboard-equity-kpis .grid {
+  column-gap: 12px;
+  row-gap: 8px;
+}
+
+.dashboard-shell .dashboard-equity-chart > div:first-child {
+  flex-wrap: wrap;
+  height: auto;
+  min-height: 20px;
+  font-size: var(--text-t2);
+  row-gap: 4px;
+}
+
+.dashboard-shell .dashboard-equity-chart > div:first-child > div {
+  white-space: normal;
+  flex-shrink: 1;
+}
+
+.dashboard-shell .dashboard-empty {
+  color: var(--dashboard-secondary);
+  font-family: var(--font-sans);
+  font-size: var(--text-t4);
+  line-height: 1.5;
+}
+
+.dashboard-shell .dashboard-empty > svg {
+  color: var(--dashboard-secondary);
+}
+
+.dashboard-shell .dashboard-card table {
+  font-variant-numeric: tabular-nums;
+}
+
+.dashboard-shell [data-card-id="bots"] table {
+  min-width: 640px;
+}
+
+.dashboard-shell [data-card-id="bots"] td:first-child .font-mono {
+  white-space: nowrap;
+}
+
+.dashboard-shell .dashboard-card th {
+  font-family: var(--font-sans);
+  font-size: var(--text-t3);
+  color: var(--dashboard-secondary);
+  white-space: nowrap;
+  height: 34px;
+}
+
+.dashboard-shell .dashboard-card td {
+  padding-block: 13px;
+}
+
+.dashboard-shell .dashboard-card td .text-t1 {
+  font-size: var(--text-t2);
+  line-height: 1.5;
+}
+
+.dashboard-shell .dashboard-card tbody tr {
+  opacity: 1;
+}
+
+.dashboard-shell .dashboard-card tbody tr:hover {
+  background: color-mix(in srgb, var(--primary) 4%, var(--surface));
+}
+
+.dashboard-shell .dashboard-card td[colspan] {
+  padding-block: 34px;
+}
+
+.dashboard-shell td[colspan] .dashboard-empty {
+  width: calc(100cqw - 24px);
+  margin-inline: 12px;
+}
+
+.dashboard-shell .dashboard-event-scroll {
+  padding: 6px 10px 10px 6px;
+  scrollbar-width: thin;
+}
+
+.dashboard-shell .dashboard-event-list {
+  padding-left: 12px;
+}
+
+.dashboard-shell .dashboard-event-list > div {
+  margin-block: 0;
+}
+
+.dashboard-shell .dashboard-event-list > div.group {
+  gap: 6px;
+}
+
+.dashboard-shell .dashboard-event-list > div.group > div:first-child {
+  margin-top: 15px;
+}
+
+.dashboard-shell .dashboard-event-content {
+  border-bottom: 1px solid color-mix(in srgb, var(--foreground) 6%, transparent);
+  border-radius: 0;
+  padding: 0 4px;
+}
+
+.dashboard-shell .dashboard-event-toggle {
+  min-height: 44px;
+  padding-block: 8px;
+}
+
+.dashboard-shell .dashboard-event-time {
+  color: var(--dashboard-secondary);
+  font-size: var(--text-t2);
+  font-variant-numeric: tabular-nums;
+}
+
+.dashboard-shell .dashboard-event-title {
+  font-size: var(--text-t3);
+  letter-spacing: 0;
+  line-height: 1.5;
+}
+
+@container dashboard-panel (width < 840px) {
+  .dashboard-shell .dashboard-chart-hint {
+    display: none;
+  }
+
+  .dashboard-shell .dashboard-allocation-header {
+    height: auto;
+    flex-wrap: wrap;
+    padding-block: 7px;
+    gap: 6px;
+  }
+
+  .dashboard-shell .dashboard-allocation-header > div:first-child {
+    width: 100%;
+    justify-content: space-between;
+    flex-wrap: wrap;
+  }
+
+  .dashboard-shell .dashboard-allocation-tabs {
+    width: 100%;
+    overflow-x: auto;
+  }
+
+  .dashboard-shell .dashboard-allocation-tabs button {
+    flex: 1;
+    padding-inline: 6px;
+  }
+}
+
+@container dashboard-panel (width < 600px) {
+  .dashboard-shell .dashboard-events-header {
+    height: auto;
+    flex-wrap: wrap;
+    padding-block: 7px;
+    gap: 6px;
+  }
+
+  .dashboard-shell .dashboard-event-tabs {
+    max-width: 100%;
+    width: 100%;
+  }
+
+  .dashboard-shell .dashboard-event-tabs button {
+    flex: 1;
+  }
+}
+
+@container dashboard-panel (width < 420px) {
+  .dashboard-shell .dashboard-panel-header {
+    height: auto;
+    flex-wrap: wrap;
+    padding-block: 7px;
+  }
+
+  .dashboard-shell .dashboard-event-title {
+    white-space: normal;
+    overflow-wrap: anywhere;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .dashboard-shell *, .dashboard-shell *::before, .dashboard-shell *::after {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* A narrow viewport reads the same panels in tree order, without saving a new layout. */
+@media (max-width: 767px) {
+  .dashboard-shell aside > a > div {
+    display: none;
+  }
+
+  .dashboard-shell .sidebar-resizer,
+  .dashboard-shell [data-layout-splitter] {
+    display: none;
+  }
+
+  .dashboard-shell .dashboard-workspace {
+    height: auto;
+    min-height: 0;
+    overflow: visible;
+  }
+
+  .dashboard-shell .dashboard-workspace > div {
+    height: auto !important;
+    min-height: 0 !important;
+  }
+
+  .dashboard-shell [data-layout-split] {
+    flex-direction: column;
+    gap: 5px;
+  }
+
+  .dashboard-shell [data-layout-branch] {
+    width: 100% !important;
+    height: auto !important;
+    flex: none !important;
+  }
+
+  .dashboard-shell [data-leaf-id] {
+    width: 100%;
+    height: 280px;
+    min-height: 280px;
+    flex: none;
+  }
+
+  .dashboard-shell [data-card-id="activity_deck"],
+  .dashboard-shell [data-card-id="incidents"],
+  .dashboard-shell [data-card-id="fills"] {
+    height: 420px;
+  }
+}
