+.dashboard-shell .dashboard-empty > span:first-of-type {
+  color: var(--muted-foreground);
+  font-size: .75rem;
+  font-weight: 500;
+}
+
+.dashboard-shell .allocation-header {
+  height: auto;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 0;
+  padding: 0;
+}
+
+.dashboard-shell .allocation-heading {
+  min-height: 39px;
+  justify-content: space-between;
+  padding: 0 12px;
+  gap: 6px;
+}
+
+.dashboard-shell .allocation-focus {
+  border: 0;
+  background: transparent;
+}
+
+.dashboard-shell .allocation-focus > span {
+  display: none;
+}
+
+.dashboard-shell .allocation-tabs {
+  width: 100%;
+  border: 0;
+  border-top: 1px solid var(--border);
+  border-radius: 0;
+  background: var(--surface);
+  padding: 0 8px;
+  gap: 0;
+  overflow-x: auto;
+}
+
+.dashboard-shell .allocation-tabs button {
+  min-height: 32px;
+  flex: 1 0 auto;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  border-radius: 0;
+  font-family: var(--font-sans);
+  font-size: .6875rem;
+  white-space: nowrap;
+}
+
+.dashboard-shell .allocation-tabs button[aria-pressed="true"] {
+  background: transparent;
+  border-bottom-color: var(--gold);
+}
+
+.dashboard-shell .allocation-donut {
+  max-width: 40%;
+  max-height: 200px;
+}
+
+.dashboard-shell .allocation-legend {
+  height: auto;
+  max-height: 100%;
+  justify-content: center;
+  gap: 8px;
+  overflow-y: auto;
+}
+
+.dashboard-shell .allocation-legend > div {
+  border-radius: 4px;
+  flex-shrink: 0;
+  min-height: 40px;
+}
+
+.dashboard-shell table thead {
+  background: color-mix(in srgb, var(--background) 45%, var(--surface));
+  color: var(--muted-foreground);
+  font-family: var(--font-sans);
+  font-size: .625rem;
+}
+
+.dashboard-shell table th {
+  padding-top: 10px;
+  padding-bottom: 10px;
+  white-space: nowrap;
+}
+
+.dashboard-shell table td {
+  padding-top: 13px;
+  padding-bottom: 13px;
+}
+
+.dashboard-shell table tbody tr {
+  opacity: 1;
+}
+
+.dashboard-shell table tbody tr:hover {
+  background: color-mix(in srgb, var(--gold) 4%, var(--surface));
+}
+
+.dashboard-shell .incident-header {
+  height: auto;
+  align-items: stretch;
+  flex-direction: column;
+  gap: 0;
+  padding: 0;
+}
+
+.dashboard-shell .incident-header > .workspace-panel-title {
+  min-height: 39px;
+  padding: 0 12px;
+}
+
+.dashboard-shell .incident-tabs {
+  max-width: 100%;
+  border: 0;
+  border-top: 1px solid var(--border);
+  border-radius: 0;
+  padding: 3px 8px;
+  background: var(--surface);
+}
+
+.dashboard-shell .incident-tabs button {
+  flex: 1 0 auto;
+  min-height: 26px;
+  font-size: .625rem;
+}
+
+.dashboard-shell .incident-scroll {
+  padding: 8px 10px 12px;
+}
+
+.dashboard-shell .incident-timeline {
+  padding-left: 2px;
+}
+
+.dashboard-shell .incident-timeline > div:first-child {
+  left: 10px;
+}
+
+.dashboard-shell .incident-row + .incident-row {
+  margin-top: 0;
+}
+
+.dashboard-shell .incident-row {
+  gap: 4px;
+}
+
+.dashboard-shell .incident-row > div:first-child {
+  margin-top: 12px;
+}
+
+.dashboard-shell .incident-row > div:last-child {
+  padding: 10px 6px;
+  border-radius: 3px;
+  border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
+}
+
+.dashboard-shell .incident-summary > div:first-child {
+  gap: 8px;
+}
+
+.dashboard-shell .incident-summary > div:first-child > span:last-child {
+  font-family: var(--font-sans);
+  font-size: .75rem;
+  line-height: 1.5;
+  color: var(--foreground);
+}
+
+.dashboard-shell .incident-row:not([data-event-level="ERROR"]):not([data-event-level="WARN"]) .incident-summary > div:first-child > span:nth-child(2) {
+  color: var(--muted-foreground);
+  background: transparent;
+  border-color: var(--border);
+}
+
+.dashboard-shell [data-event-level="WARN"] > div:last-child,
+.dashboard-shell [data-event-level="ERROR"] > div:last-child {
+  border-left: 2px solid currentColor;
+}
+
+.dashboard-shell [data-event-level="WARN"] { color: var(--warn); }
+.dashboard-shell [data-event-level="ERROR"] { color: var(--down); }
+
+.dashboard-shell ::-webkit-scrollbar { width: 5px; height: 5px; }
+.dashboard-shell ::-webkit-scrollbar-track { background: transparent; }
+.dashboard-shell ::-webkit-scrollbar-thumb { background: #414750; border-radius: 4px; }
+
+@container (max-width: 560px) {
+  .dashboard-shell .equity-metrics { width: 184px; padding: 12px 10px; }
