+/* 首頁的工作台層級；沿用使用者的版面、主題與數據來源。 */
+.dashboard-shell {
+  --background: color-mix(in srgb, var(--color-background) 85%, #000);
+  --surface: color-mix(in srgb, var(--color-surface) 86%, #000);
+  --surface-raised: var(--color-surface-raised);
+  --foreground: #edf0f2;
+  --muted-foreground: #9ca3ad;
+  --gold: color-mix(in srgb, var(--primary) 68%, #ded1b9);
+  --gold-bright: color-mix(in srgb, var(--primary) 55%, #fff);
+  --gold-dim: color-mix(in srgb, var(--primary) 55%, #363431);
+  --border: color-mix(in srgb, var(--color-border) 70%, #454c55);
+  --sidebar: var(--color-sidebar);
+  --accent: #29251d;
+  --ring: #d7b578;
+  --text-t1: .625rem;
+  --text-t2: .6875rem;
+  --text-t3: .75rem;
+  --text-t4: .8125rem;
+  background: var(--background);
+}
+
+.dashboard-shell .text-t1 { font-size: var(--text-t1); }
+.dashboard-shell .text-t2 { font-size: var(--text-t2); }
+.dashboard-shell .text-t3 { font-size: var(--text-t3); }
+.dashboard-shell .text-t4 { font-size: var(--text-t4); }
+
+.dashboard-shell aside {
+  border-right-color: var(--border);
+}
+
+.dashboard-shell aside > a {
+  height: 56px;
+  border-bottom: 1px solid var(--border);
+}
+
+.dashboard-shell aside > a > span {
+  box-shadow: none;
+  border-radius: 7px;
+}
+
+.dashboard-shell nav {
+  padding-top: 10px;
+  scrollbar-width: thin;
+}
+
+.dashboard-shell nav p {
+  color: var(--muted-foreground);
+  font-size: .5625rem;
+  letter-spacing: .08em;
+}
+
+.dashboard-shell nav a {
+  border: 1px solid transparent;
+  transition: background-color 120ms, border-color 120ms;
+}
+
+.dashboard-shell nav a[aria-current="page"] {
+  border-color: color-mix(in srgb, var(--gold) 26%, transparent);
+  background: color-mix(in srgb, var(--gold) 9%, var(--sidebar));
+  box-shadow: inset 2px 0 var(--gold);
+}
+
+.dashboard-shell nav a[aria-current="page"] span,
+.dashboard-shell nav a[aria-current="page"] svg {
+  color: var(--gold-bright);
+}
+
+.dashboard-shell nav a > div > span:last-child {
+  font-size: .5625rem;
+  font-weight: 400;
+  letter-spacing: .025em;
+  opacity: .65;
+}
+
+.dashboard-shell > div > header {
+  height: 48px;
+  background: var(--background);
+}
+
+.dashboard-shell > div > header h1 {
+  font-size: .8125rem;
+  font-weight: 600;
+}
+
+.dashboard-shell .account-engine {
+  white-space: nowrap;
+  font-size: .5625rem;
+}
+
+.dashboard-shell .service-evidence[open] summary {
+  color: var(--gold-bright);
+}
+
+.dashboard-shell main {
+  padding: 12px;
+}
+
+.dashboard-shell .dashboard-workspace {
+  height: calc(100dvh - 72px);
+}
+
+.dashboard-shell [data-leaf-id] {
+  background: var(--surface);
+  border-color: var(--border);
+  box-shadow: none;
+  container-type: inline-size;
+}
+
+.dashboard-shell [data-card-id="equity"] {
+  border-top-color: var(--gold-dim);
+}
+
+.dashboard-shell .workspace-panel-header {
+  height: 40px;
+  min-height: 40px;
+  padding-inline: 12px;
+  background: var(--surface-raised);
+  border-bottom-color: var(--border);
+}
+
+.dashboard-shell .workspace-panel-title {
+  gap: 8px;
+  min-width: 0;
+  flex-shrink: 1;
+  font-family: var(--font-sans);
+}
+
+.dashboard-shell .workspace-panel-title h2 {
+  font-size: .8125rem;
+  line-height: 1.4;
+  font-weight: 600;
+  letter-spacing: .015em;
+}
+
+.dashboard-shell .workspace-panel-icon {
+  display: block;
+  color: var(--muted-foreground);
+}
+
+.dashboard-shell .equity-card .workspace-panel-icon {
+  color: var(--gold);
+}
+
+.dashboard-shell button[aria-pressed="true"],
+.dashboard-shell .workspace-panel-header button.bg-secondary {
+  color: var(--gold-bright);
