{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第 2 層排程提案",
  "description": "FR-26：schedule.py 依優先序（槽位權重 × 痛點 × 使用頻率 × 證據等級）把第 1 層建議排實測的候選排進每週額度。存在 data/funnel/layer2-schedule.json。只是提案，由維護者決定要不要照排。",
  "type": "object",
  "required": ["generated", "start", "limits", "weeks", "unscheduled", "candidates", "excluded"],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "test": {
      "type": "object",
      "required": ["slot", "judge", "size", "incumbent", "challengers", "priority", "tokens_est", "over_cap"],
      "properties": {
        "slot": { "type": "string" },
        "judge": { "enum": ["objective", "blind"] },
        "size": { "enum": ["short", "medium", "heavy"] },
        "incumbent": { "description": "現任；空的代表跟內建功能比", "type": "array", "items": { "type": "string" } },
        "challengers": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
        "priority": { "type": "number", "minimum": 0 },
        "tokens_est": { "description": "每次 token × 次數 × (1 + 挑戰者數) × agent 數", "type": "integer", "minimum": 0 },
        "over_cap": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  },
  "properties": {
    "generated": { "$ref": "#/$defs/date" },
    "start": { "$ref": "#/$defs/date" },
    "limits": {
      "type": "object",
      "required": ["weekly_tokens", "weekly_blind", "usage"],
      "properties": {
        "weekly_tokens": { "type": "integer", "minimum": 0 },
        "weekly_blind": { "type": "integer", "minimum": 0 },
        "usage": { "type": "string" }
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "tokens", "blind", "tests"],
        "properties": {
          "start": { "$ref": "#/$defs/date" },
          "tokens": { "type": "integer", "minimum": 0 },
          "blind": { "type": "integer", "minimum": 0 },
          "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
        }
      }
    },
    "unscheduled": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/test" }, { "required": ["reason"] }] }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "slot", "priority", "factors", "notes"],
        "properties": {
          "tool": { "type": "string" },
          "slot": { "type": "string" },
          "priority": { "type": "number", "minimum": 0 },
          "factors": {
            "type": "object",
            "required": ["weight", "pain", "usage", "evidence"],
            "properties": {
              "weight": { "type": "number" },
              "pain": { "type": "integer", "minimum": 1, "maximum": 3 },
              "usage": { "type": "integer", "minimum": 1, "maximum": 3 },
              "evidence": { "enum": ["E0", "E1", "E2"] }
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "reason"],
        "properties": { "tool": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  }
}
