{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 工具資料卡",
  "description": "一個工具一張卡，存成 data/tools/<id>.yaml。",
  "type": "object",
  "required": ["id", "name", "slots", "status", "added"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "description": "skill、plugin、mcp、cli、app（獨立程式）、service（線上服務或 API）、library（程式庫或框架，要自己寫程式呼叫）、native（Claude Code 或 Codex 內建）、collection（多個 skill 的集合）、rules（規則包）",
      "enum": ["skill", "plugin", "mcp", "cli", "app", "service", "library", "native", "collection", "rules"]
    },
    "slots": {
      "description": "所屬槽位；還沒分配或屬於零件庫時可以是空陣列",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": {
      "description": "Golden Path 四環對應：Adopt（default 預設）、Trial（trial 試用、on_demand 按需備案）、Assess（assess 觀察中、pending 待評估）、Hold（rejected 拒絕、retired 退役）",
      "enum": ["default", "trial", "on_demand", "assess", "pending", "rejected", "retired"]
    },
    "ring": {
      "description": "Golden Path 四環分類（adopt / trial / assess / hold）；未填時依 status 自動推導",
      "enum": ["adopt", "trial", "assess", "hold"]
    },
    "trigger_when": {
      "description": "on_demand 工具的按需觸發條件索引（Progressive Disclosure，不載入常駐規則或工作流）",
      "type": "string",
      "minLength": 1
    },
    "url": { "type": "string", "pattern": "^https://" },
    "works_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "decided_at": { "$ref": "#/$defs/date" },
    "reason": { "type": "string", "minLength": 1 },
    "trial_until": { "$ref": "#/$defs/date" },
    "replaces": { "$ref": "#/$defs/id" },
    "plugin": {
      "description": "可以用 plugin 安裝時的來源，依 agent 分開；狀態是 default 的才會寫進 marketplace。git 來源要固定 sha，npm 要固定版本。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "plugin.json 裡的名稱；跟卡片 id 不同時才要填",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "claude": {
          "description": "寫進 .claude-plugin/marketplace.json 的 source",
          "oneOf": [
            { "$ref": "#/$defs/githubSource" },
            { "$ref": "#/$defs/urlSource" },
            { "$ref": "#/$defs/gitSubdirSource" },
            { "$ref": "#/$defs/npmSource" }
          ]
        },
        "codex": {
          "description": "寫進 .agents/plugins/marketplace.json 的 source；Codex 沒有 github 這種來源",
          "oneOf": [
            { "$ref": "#/$defs/urlSource" },
            { "$ref": "#/$defs/gitSubdirSource" },
            { "$ref": "#/$defs/npmSource" }
          ]
        }
      }
    },
    "sources": {
      "description": "這張卡從哪裡來，例如訪談、桌機盤點、RIA:C024",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" },
    "baseline_eval": {
      "description": "Anti-Hobbling 裸模型／基準對照錨點（供 default 卡追蹤上次在哪一代模型驗證過仍有正收益）",
      "type": "object",
      "required": ["verified_at", "verified_model", "verdict"],
      "additionalProperties": false,
      "properties": {
        "verified_at": { "$ref": "#/$defs/date" },
        "verified_model": { "type": "string", "minLength": 1 },
        "verdict": {
          "description": "beats_vanilla（全面勝過裸模型）、scoped_beats_vanilla（特定環境勝出、其餘與裸模型打平）、ties_vanilla（打平，待檢討降級）、essential_infra（跨家 GUI／資安門禁等裸模型本身不含之基礎設施）",
          "enum": ["beats_vanilla", "scoped_beats_vanilla", "ties_vanilla", "essential_infra"]
        },
        "scope_note": { "type": "string", "minLength": 1 },
        "eval_doc": { "type": "string", "minLength": 1 }
      }
    },
    "added": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "description": "正式採用、試用或退役都要留理由與日期，而且要放在某個槽位",
      "if": { "properties": { "status": { "enum": ["default", "trial", "retired"] } } },
      "then": { "required": ["reason", "decided_at"], "properties": { "slots": { "minItems": 1 } } }
    },
    {
      "description": "觀察（Assess）或拒絕（Hold）都要留評估理由與日期（不在任何槽位範圍的工具可留空 slots）",
      "if": { "properties": { "status": { "enum": ["assess", "rejected"] } } },
      "then": { "required": ["reason", "decided_at"] }
    },
    {
      "description": "按需備案要寫觸發條件索引與決定日期（Progressive Disclosure，不常駐）",
      "if": { "properties": { "status": { "const": "on_demand" } } },
      "then": { "required": ["trigger_when", "decided_at"] }
    },
    {
      "description": "新工具先試用兩週，要寫到期日",
      "if": { "properties": { "status": { "const": "trial" } } },
      "then": { "required": ["trial_until"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha": { "description": "完整的 40 碼 commit SHA", "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "githubSource": {
      "type": "object",
      "required": ["source", "repo", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "github" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "urlSource": {
      "type": "object",
      "required": ["source", "url", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "url" },
        "url": { "type": "string", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "gitSubdirSource": {
      "type": "object",
      "required": ["source", "url", "path", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "git-subdir" },
        "url": { "type": "string", "pattern": "^https://" },
        "path": { "description": "repo 裡的子目錄，不能以 / 或 . 開頭", "type": "string", "pattern": "^[A-Za-z0-9_-][^\\\\]*$" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "npmSource": {
      "type": "object",
      "required": ["source", "package", "version"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "npm" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "description": "固定的確切版本，不接受範圍", "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
