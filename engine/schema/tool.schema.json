{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 工具資料卡",
  "description": "一個工具一張卡，存成 data/tools/<id>.yaml。",
  "type": "object",
  "required": ["id", "name", "slots", "status", "added"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "description": "skill、plugin、mcp、cli、app（獨立程式）、service（線上服務或 API）、library（程式庫或框架，要自己寫程式呼叫）、native（Claude Code 或 Codex 內建）、collection（多個 skill 的集合）、rules（規則包）",
      "enum": ["skill", "plugin", "mcp", "cli", "app", "service", "library", "native", "collection", "rules"]
    },
    "slots": {
      "description": "所屬槽位；還沒分配或屬於零件庫時可以是空陣列",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": {
      "description": "default 預設、trial 試用、pending 待評估、rejected 拒絕、retired 退役",
      "enum": ["default", "trial", "pending", "rejected", "retired"]
    },
    "url": { "type": "string", "pattern": "^https://" },
    "works_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "decided_at": { "$ref": "#/$defs/date" },
    "reason": { "type": "string", "minLength": 1 },
    "trial_until": { "$ref": "#/$defs/date" },
    "replaces": { "$ref": "#/$defs/id" },
    "plugin": {
      "description": "可以用 plugin 安裝時的來源，依 agent 分開；狀態是 default 的才會寫進 marketplace。git 來源要固定 sha，npm 要固定版本。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "plugin.json 裡的名稱；跟卡片 id 不同時才要填",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "claude": {
          "description": "寫進 .claude-plugin/marketplace.json 的 source",
          "oneOf": [
            { "$ref": "#/$defs/githubSource" },
            { "$ref": "#/$defs/urlSource" },
            { "$ref": "#/$defs/gitSubdirSource" },
            { "$ref": "#/$defs/npmSource" }
          ]
        },
        "codex": {
          "description": "寫進 .agents/plugins/marketplace.json 的 source；Codex 沒有 github 這種來源",
          "oneOf": [
            { "$ref": "#/$defs/urlSource" },
            { "$ref": "#/$defs/gitSubdirSource" },
            { "$ref": "#/$defs/npmSource" }
          ]
        }
      }
    },
    "sources": {
      "description": "這張卡從哪裡來，例如訪談、桌機盤點、RIA:C024",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" },
    "added": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "description": "換或不換都要留理由與日期，而且要放在某個槽位",
      "if": { "properties": { "status": { "enum": ["default", "trial", "rejected", "retired"] } } },
      "then": { "required": ["reason", "decided_at"], "properties": { "slots": { "minItems": 1 } } }
    },
    {
      "description": "新工具先試用兩週，要寫到期日",
      "if": { "properties": { "status": { "const": "trial" } } },
      "then": { "required": ["trial_until"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha": { "description": "完整的 40 碼 commit SHA", "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "githubSource": {
      "type": "object",
      "required": ["source", "repo", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "github" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "urlSource": {
      "type": "object",
      "required": ["source", "url", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "url" },
        "url": { "type": "string", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "gitSubdirSource": {
      "type": "object",
      "required": ["source", "url", "path", "sha"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "git-subdir" },
        "url": { "type": "string", "pattern": "^https://" },
        "path": { "description": "repo 裡的子目錄，不能以 / 或 . 開頭", "type": "string", "pattern": "^[A-Za-z0-9_-][^\\\\]*$" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "npmSource": {
      "type": "object",
      "required": ["source", "package", "version"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "npm" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "description": "固定的確切版本，不接受範圍", "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
