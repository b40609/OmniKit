{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 工具資料卡",
  "description": "一個工具一張卡，存成 data/tools/<id>.yaml。",
  "type": "object",
  "required": ["id", "name", "slots", "status", "added"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "description": "skill、plugin、mcp、cli、app（獨立程式）、service（線上服務或 API）、native（Claude Code 或 Codex 內建）、collection（多個 skill 的集合）、rules（規則包）",
      "enum": ["skill", "plugin", "mcp", "cli", "app", "service", "native", "collection", "rules"]
    },
    "slots": {
      "description": "所屬槽位；還沒分配或屬於零件庫時可以是空陣列",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": {
      "description": "default 預設、trial 試用、pending 待評估、rejected 拒絕、retired 退役",
      "enum": ["default", "trial", "pending", "rejected", "retired"]
    },
    "url": { "type": "string", "pattern": "^https://" },
    "works_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "decided_at": { "$ref": "#/$defs/date" },
    "reason": { "type": "string", "minLength": 1 },
    "trial_until": { "$ref": "#/$defs/date" },
    "replaces": { "$ref": "#/$defs/id" },
    "sources": {
      "description": "這張卡從哪裡來，例如訪談、桌機盤點、RIA:C024",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" },
    "added": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "description": "換或不換都要留理由與日期，而且要放在某個槽位",
      "if": { "properties": { "status": { "enum": ["default", "trial", "rejected", "retired"] } } },
      "then": { "required": ["reason", "decided_at"], "properties": { "slots": { "minItems": 1 } } }
    },
    {
      "description": "新工具先試用兩週，要寫到期日",
      "if": { "properties": { "status": { "const": "trial" } } },
      "then": { "required": ["trial_until"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
