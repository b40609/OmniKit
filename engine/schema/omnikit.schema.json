{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 公開設定",
  "description": "data/omnikit.yaml：看板與 marketplace 用的設定。",
  "type": "object",
  "required": ["title", "tagline", "repo", "marketplace", "owner"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1 },
    "repo": { "description": "owner/repo", "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "marketplace": {
      "description": "英數、. _ -，以英數開頭，不能有 ..",
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "owner": { "type": "string", "minLength": 1 },
    "eval": {
      "description": "評估 skill 的設定",
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly_deep_limit"],
      "properties": {
        "weekly_deep_limit": { "description": "每週最多跑幾次第 2 層深度評估", "type": "integer", "minimum": 0 }
      }
    }
  }
}
