{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 模組",
  "description": "一個模組一個檔（data/modules/<層>/<id>.yaml），裡面是幾個槽位。層有三種：foundation 是 agent 自己怎麼運作，每個人都有；capability 是 agent 碰得到什麼（瀏覽器、Office 檔、桌面程式），由領域帶入；domain 是一種業務要交付的成果，使用者自己選。",
  "type": "object",
  "required": ["id", "kind", "name", "summary", "slots"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": {
      "description": "要跟所在的資料夾名稱一樣",
      "enum": ["foundation", "capability", "domain"]
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "description": "一句話說明這個模組管什麼", "type": "string", "minLength": 1 },
    "maintainer_only": {
      "description": "只有 foundation 能用：true 表示維護名冊的人才啟用，其他人不會看到",
      "type": "boolean"
    },
    "requires": {
      "description": "只有 domain 能用：選了這個領域就一起帶入的 capability 模組",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "signals": {
      "description": "只有 domain 能用：掃描專案與訪談時，用來預選這個領域的線索",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "maps_to": {
      "description": "外部目錄的類別名稱；匯入候選時，那些類別的條目先落在這個模組",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "slot": {
      "description": "槽位是一件要交付的工作；同一件工作在不同 agent 上可以有不同的答案",
      "type": "object",
      "required": ["id", "name", "focus", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "focus": {
          "description": "active：主動找更好的工具，每週的深度評估額度只用在這些槽位；watch：有新工具進來才做免費初篩；frozen：不評估、不動預設",
          "enum": ["active", "watch", "frozen"]
        },
        "scenarios": {
          "description": "評估工具時用的真實情境",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]+$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "search": {
          "description": "找候選用的關鍵字：匯入外部目錄、agent 上網找工具時都用它",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "answers": {
          "description": "這件工作在每個 agent 上的答案；沒列的 agent 就是還不知道",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": { "$ref": "#/$defs/answer" },
            "codex": { "$ref": "#/$defs/answer" },
            "antigravity": { "$ref": "#/$defs/answer" }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "required": ["verdict"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "description": "native：內建的就夠；tool：建議裝 tool 指的那張卡；none：找過了，沒有好選擇；unknown：還不知道",
          "enum": ["native", "tool", "none", "unknown"]
        },
        "tool": { "$ref": "#/$defs/id" },
        "reason": {
          "description": "native、tool、none 寫為什麼這樣決定。unknown 可以先寫這個 agent 內建的功能是什麼（還沒實測夠不夠）：給建議時會拿它當「用內建的就好」的候選，並註明還沒實測",
          "type": "string",
          "minLength": 1
        },
        "evidence": { "description": "實測紀錄或來源的路徑、網址", "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "tool" } } },
          "then": { "required": ["tool"] },
          "else": { "not": { "required": ["tool"] } }
        },
        {
          "if": { "properties": { "verdict": { "enum": ["native", "tool", "none"] } } },
          "then": { "required": ["reason", "decided_at"] }
        }
      ]
    }
  }
}
