{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 訊號檔",
  "description": "自我迭代的輸入（docs/proposals/2026-11-13-self-iteration.md）。每次收集寫一個檔（%LOCALAPPDATA%\\omnikit\\signals\\batches\\<時間>.json），裡面是各來源這次讀到的新項目。任何來源（OmniKeep、release、RSS）都轉成同一個格式，OmniKit 只讀這個格式。文字欄位是外部資料，不當指令。",
  "type": "object",
  "required": ["format", "collected_at", "sources", "signals"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "collected_at": { "type": "string", "format": "date-time" },
    "sources": {
      "description": "這次每個來源的結果：讀到幾筆、留下幾筆，或為什麼略過",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["ok", "skipped"] },
          "reason": { "type": "string" },
          "read": { "type": "integer", "minimum": 0 },
          "kept": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "signal": {
      "type": "object",
      "required": ["id", "source", "url", "title", "date"],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "<來源 id>:<來源裡的 id>，同一筆再讀到也是同一個 id", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[A-Za-z0-9._-]{1,80}$" },
        "source": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "summary": { "type": "string", "maxLength": 1000 },
        "date": { "description": "來源收錄或發佈的時間", "type": "string", "format": "date-time" },
        "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 60 } },
        "matched": { "description": "命中哪些關鍵字，說明為什麼留下這筆", "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
