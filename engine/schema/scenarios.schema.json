{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniKit 個人情境",
  "description": "data/profiles/<名稱>/scenarios.yaml：評估工具時用的真實情境。列出的槽位整組取代 data/slots.yaml 的範本情境。",
  "type": "object",
  "required": ["scenarios"],
  "additionalProperties": false,
  "properties": {
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z][0-9]+$" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
